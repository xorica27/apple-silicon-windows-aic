+        return;
+    }
+    if (!aic->physlen) {
+        error_setg(errp, "APPLE_AIC: mmio size must be nonzero");
+        return;
+    }
+
     memory_region_init_io(&aic->mmio, OBJECT(dev), &apple_aic_ops, aic, TYPE_APPLE_AIC, aic->physlen);
     sysbus_init_mmio(SYS_BUS_DEVICE(dev), &aic->mmio);
 
