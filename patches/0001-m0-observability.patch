+            aic->r_iack = *iack_offset;
             break;
 
         default:
@@ -274,7 +327,28 @@ DeviceState *apple_aic_create(struct dtree_node *adt_node, uint64_t iobase) {
             break;
     }
 
+    apple_aic_configure(aic);
+
     sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
     sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, aic_reg[0].base + iobase);
     return dev;
 }
+
+DeviceState *apple_aic_create_simple(uint32_t version, uint32_t num_irqs,
+                                     uint64_t physlen, uint64_t iack_offset,
+                                     bool has_ack_region)
+{
+    DeviceState *dev = qdev_new(TYPE_APPLE_AIC);
+    AppleAICState *aic = APPLE_AIC(dev);
+
+    aic->version = version;
+    aic->num_irqs = num_irqs;
+    aic->physlen = physlen;
+    aic->r_iack = iack_offset;
+    aic->has_ack_region = has_ack_region;
+
+    apple_aic_configure(aic);
+
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    return dev;
+}
