diff --git a/tests/qtest/apple-aic-test.c b/tests/qtest/apple-aic-test.c
new file mode 100644
index 0000000..3f1fc30
--- /dev/null
+++ b/tests/qtest/apple-aic-test.c
@@ -0,0 +1,222 @@
+#include "qemu/osdep.h"
+#include "libqtest.h"
+
+#define CTRL_BASE       0x20020000
+#define CTRL_SET        0x0
+#define CTRL_CLEAR      0x4
+
+#define AIC_IPI_SEND    0x2008
+#define AIC_IPI_ACK     0x200c
+
+typedef struct AicConfig {
+    const char *machine;
+    uint64_t aic_base;
+    uint32_t num_ints_reg;
+    uint32_t iack;
+    uint32_t enable_base;
+    uint32_t disable_base;
+    uint32_t hw_state_base;
+    uint32_t target_base;
+    bool target_is_mask;
+    uint32_t target_value;
+    uint32_t num_irqs;
+    uint32_t uart_irq;
+} AicConfig;
+
+static const AicConfig aic_v1 = {
+    .machine = "apple-aic-test",
+    .aic_base = 0x20000000,
+    .num_ints_reg = 0x4,
+    .iack = 0x2004,
+    .enable_base = 0x4180,
+    .disable_base = 0x4100,
+    .hw_state_base = 0x4200,
+    .target_base = 0x3000,
+    .target_is_mask = true,
+    .target_value = 2, /* BIT(1) */
+    .num_irqs = 256,
+    .uart_irq = 100,
+};
+
+static const AicConfig aic_v2 = {
+    .machine = "apple-aic-v2-test",
+    .aic_base = 0x28E100000,
+    .num_ints_reg = 0x0C,
+    .iack = 0xC000,
+    .enable_base = 0x6600,
+    .disable_base = 0x6400,
+    .hw_state_base = 0x6800,
+    .target_base = 0x2000,
+    .target_is_mask = false,
+    .target_value = 1, /* CPU index 1 */
+    .num_irqs = 4096,
+    .uart_irq = 1097,
+};
+
+static inline uint32_t bit_off(uint32_t base, uint32_t irq)
+{
+    return base + (irq / 32) * 4;
+}
+
+static inline uint32_t bit_val(uint32_t irq)
+{
+    return 1u << (irq % 32);
+}
+
+static QTestState *aic_qtest(const AicConfig *cfg)
+{
+    return qtest_initf("-M %s -smp 2 -m 128M", cfg->machine);
+}
+
+static void test_num_ints(gconstpointer data)
+{
+    const AicConfig *cfg = data;
+    QTestState *qts = aic_qtest(cfg);
+
+    g_assert_cmpuint(qtest_readl(qts, cfg->aic_base + cfg->num_ints_reg), ==,
+                     cfg->num_irqs);
+    qtest_quit(qts);
+}
+
+static void test_readq_num_ints(gconstpointer data)
+{
+    const AicConfig *cfg = data;
+    QTestState *qts = aic_qtest(cfg);
+
+    g_assert_cmpuint(qtest_readq(qts, cfg->aic_base + cfg->num_ints_reg), ==,
+                     cfg->num_irqs);
+    qtest_quit(qts);
+}
+
+static void test_enable_raise_ack(gconstpointer data)
+{
+    const AicConfig *cfg = data;
+    uint32_t irq = cfg->uart_irq;
+    QTestState *qts = aic_qtest(cfg);
+
+    qtest_writel(qts, cfg->aic_base + bit_off(cfg->enable_base, irq),
+                 bit_val(irq));
+    qtest_writel(qts, CTRL_BASE + CTRL_SET, irq);
+
+    g_assert_cmpuint(qtest_readl(qts, cfg->aic_base + cfg->iack), ==,
+                     irq | 0x10000);
+    g_assert_cmpuint(qtest_readl(qts, cfg->aic_base + cfg->iack), ==, 0);
+
+    qtest_writel(qts, CTRL_BASE + CTRL_CLEAR, irq);
+    qtest_quit(qts);
+}
+
+static void test_mask(gconstpointer data)
+{
+    const AicConfig *cfg = data;
+    uint32_t irq = cfg->uart_irq;
+    QTestState *qts = aic_qtest(cfg);
+
+    qtest_writel(qts, cfg->aic_base + bit_off(cfg->enable_base, irq),
+                 bit_val(irq));
+    qtest_writel(qts, cfg->aic_base + bit_off(cfg->disable_base, irq),
+                 bit_val(irq));
+    qtest_writel(qts, CTRL_BASE + CTRL_SET, irq);
+    g_assert_cmpuint(qtest_readl(qts, cfg->aic_base + cfg->iack), ==, 0);
+    qtest_writel(qts, CTRL_BASE + CTRL_CLEAR, irq);
+
+    qtest_writel(qts, cfg->aic_base + bit_off(cfg->enable_base, irq),
+                 bit_val(irq));
+    qtest_writel(qts, CTRL_BASE + CTRL_SET, irq);
+    g_assert_cmpuint(qtest_readl(qts, cfg->aic_base + cfg->iack), ==,
+                     irq | 0x10000);
+    qtest_writel(qts, CTRL_BASE + CTRL_CLEAR, irq);
+
+    qtest_quit(qts);
+}
+
+static void test_hw_state(gconstpointer data)
+{
+    const AicConfig *cfg = data;
+    uint32_t irq = cfg->uart_irq;
+    QTestState *qts = aic_qtest(cfg);
+
+    qtest_writel(qts, cfg->aic_base + bit_off(cfg->enable_base, irq),
+                 bit_val(irq));
+    qtest_writel(qts, CTRL_BASE + CTRL_SET, irq);
+
+    g_assert_cmpuint(qtest_readl(qts,
+                     cfg->aic_base + bit_off(cfg->hw_state_base, irq)), ==,
+                     bit_val(irq));
+
+    qtest_readl(qts, cfg->aic_base + cfg->iack);
+    g_assert_cmpuint(qtest_readl(qts,
+                     cfg->aic_base + bit_off(cfg->hw_state_base, irq)), ==, 0);
+
+    qtest_writel(qts, CTRL_BASE + CTRL_CLEAR, irq);
+    qtest_quit(qts);
+}
+
+static void test_target(gconstpointer data)
+{
+    const AicConfig *cfg = data;
+    uint32_t irq = cfg->uart_irq;
+    QTestState *qts = aic_qtest(cfg);
+
+    qtest_writel(qts, cfg->aic_base + cfg->target_base + irq * 4,
+                 cfg->target_value);
+    g_assert_cmpuint(qtest_readl(qts,
+                     cfg->aic_base + cfg->target_base + irq * 4), ==,
+                     cfg->target_value);
+
+    qtest_quit(qts);
+}
+
+static void test_ipi_v1(gconstpointer data)
+{
+    const AicConfig *cfg = data;
+    QTestState *qts = aic_qtest(cfg);
+
+    qtest_writel(qts, cfg->aic_base + AIC_IPI_SEND, 1); /* self IPI, CPU0 */
+    g_assert_cmpuint(qtest_readl(qts, cfg->aic_base + cfg->iack), ==,
+                     0x40001); /* type IPI, num OTHER */
+
+    qtest_writel(qts, cfg->aic_base + AIC_IPI_ACK, 1);
+    g_assert_cmpuint(qtest_readl(qts, cfg->aic_base + cfg->iack), ==, 0);
+
+    qtest_quit(qts);
+}
+
+static void test_unknown_register(gconstpointer data)
+{
+    const AicConfig *cfg = data;
+    QTestState *qts = aic_qtest(cfg);
+
+    g_assert_cmpuint(qtest_readl(qts, cfg->aic_base + 0x1234), ==, 0);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    qtest_add_data_func("/apple-aic/v1/num-ints", &aic_v1, test_num_ints);
+    qtest_add_data_func("/apple-aic/v1/readq-num-ints", &aic_v1,
+                        test_readq_num_ints);
+    qtest_add_data_func("/apple-aic/v1/enable-raise-ack", &aic_v1,
+                        test_enable_raise_ack);
+    qtest_add_data_func("/apple-aic/v1/mask", &aic_v1, test_mask);
+    qtest_add_data_func("/apple-aic/v1/hw-state", &aic_v1, test_hw_state);
+    qtest_add_data_func("/apple-aic/v1/target", &aic_v1, test_target);
+    qtest_add_data_func("/apple-aic/v1/ipi", &aic_v1, test_ipi_v1);
+    qtest_add_data_func("/apple-aic/v1/unknown-register", &aic_v1,
+                        test_unknown_register);
+
+    qtest_add_data_func("/apple-aic/v2/num-ints", &aic_v2, test_num_ints);
+    qtest_add_data_func("/apple-aic/v2/readq-num-ints", &aic_v2,
+                        test_readq_num_ints);
+    qtest_add_data_func("/apple-aic/v2/enable-raise-ack", &aic_v2,
+                        test_enable_raise_ack);
+    qtest_add_data_func("/apple-aic/v2/mask", &aic_v2, test_mask);
+    qtest_add_data_func("/apple-aic/v2/hw-state", &aic_v2, test_hw_state);
+    qtest_add_data_func("/apple-aic/v2/target", &aic_v2, test_target);
+    qtest_add_data_func("/apple-aic/v2/unknown-register", &aic_v2,
+                        test_unknown_register);
+
+    return g_test_run();
+}
