diff --git a/hw/arm/apple_aic_test.c b/hw/arm/apple_aic_test.c
new file mode 100644
index 0000000..39143f2
--- /dev/null
+++ b/hw/arm/apple_aic_test.c
@@ -0,0 +1,229 @@
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/arm/boot.h"
+#include "hw/arm/machines-qom.h"
+#include "hw/char/pl011.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
+#include "hw/intc/apple_aic.h"
+#include "system/address-spaces.h"
+#include "system/system.h"
+#include "target/arm/cpu.h"
+
+#define TYPE_APPLE_AIC_TEST_MACHINE MACHINE_TYPE_NAME("apple-aic-test")
+#define TYPE_APPLE_AIC_V2_TEST_MACHINE MACHINE_TYPE_NAME("apple-aic-v2-test")
+OBJECT_DECLARE_SIMPLE_TYPE(AppleAICTestState, APPLE_AIC_TEST_MACHINE)
+
+#define APPLE_AIC_TEST_RAM_BASE     0x40000000
+#define APPLE_AIC_TEST_CTRL_BASE    0x20020000
+#define APPLE_AIC_TEST_CTRL_SIZE    0x1000
+
+#define APPLE_AIC_TEST_CTRL_SET     0x0
+#define APPLE_AIC_TEST_CTRL_CLEAR   0x4
+
+typedef struct AppleAICTestVariant {
+    uint32_t aic_version;
+    uint32_t num_irqs;
+    uint64_t aic_physlen;
+    uint64_t iack_offset;
+    bool has_ack_region;
+    uint64_t aic_base;
+    uint64_t uart_base;
+    uint32_t uart_irq;
+    bool timer_fiq;
+    uint32_t timer_irq;
+} AppleAICTestVariant;
+
+static const AppleAICTestVariant apple_aic_v1_variant = {
+    .aic_version = AIC_V1,
+    .num_irqs = 256,
+    .aic_physlen = 0x8000,
+    .iack_offset = 0x2004,
+    .has_ack_region = true,
+    .aic_base = 0x20000000,
+    .uart_base = 0x20010000,
+    .uart_irq = 100,
+    .timer_fiq = false,
+    .timer_irq = 27,
+};
+
+/*
+ * M1 Pro (t600x) layout: AIC v2 at 0x28e100000, event/IACK at +0xc000,
+ * enable 0x6600, disable 0x6400. UART0 at 0x39b200000, AIC IRQ 1097.
+ * The real timer is FIQ, not an AIC line.
+ */
+static const AppleAICTestVariant apple_aic_v2_variant = {
+    .aic_version = AIC_V2,
+    .num_irqs = 4096,
+    .aic_physlen = 0x50000,
+    .iack_offset = 0xC000,
+    .has_ack_region = false,
+    .aic_base = 0x28E100000,
+    .uart_base = 0x39B200000,
+    .uart_irq = 1097,
+    .timer_fiq = true,
+    .timer_irq = 0,
+};
+
+struct AppleAICTestState {
+    MachineState parent_obj;
+    ARMCPU *cpu;
+    DeviceState *aic;
+    qemu_irq *aic_in;
+    uint32_t num_irqs;
+    MemoryRegion ctrl;
+    const AppleAICTestVariant *variant;
+};
+
+static uint64_t apple_aic_test_ctrl_read(void *opaque, hwaddr offset,
+                                         unsigned size)
+{
+    return 0;
+}
+
+static void apple_aic_test_ctrl_write(void *opaque, hwaddr offset,
+                                      uint64_t value, unsigned size)
+{
+    AppleAICTestState *s = opaque;
+
+    if (value >= s->num_irqs) {
+        return;
+    }
+
+    switch (offset) {
+    case APPLE_AIC_TEST_CTRL_SET:
+        qemu_set_irq(s->aic_in[value], 1);
+        break;
+    case APPLE_AIC_TEST_CTRL_CLEAR:
+        qemu_set_irq(s->aic_in[value], 0);
+        break;
+    default:
+        break;
+    }
+}
+
+static const MemoryRegionOps apple_aic_test_ctrl_ops = {
+    .read = apple_aic_test_ctrl_read,
+    .write = apple_aic_test_ctrl_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+};
+
+static void apple_aic_test_init(MachineState *ms,
+                                const AppleAICTestVariant *variant)
+{
+    AppleAICTestState *s = APPLE_AIC_TEST_MACHINE(ms);
+    MemoryRegion *ram = g_new(MemoryRegion, 1);
+    Object *cpuobj;
+    DeviceState *cpudev;
+    uint32_t i;
+
+    s->variant = variant;
+    s->num_irqs = variant->num_irqs;
+
+    memory_region_init_ram(ram, NULL, "apple-aic-test.ram", ms->ram_size,
+                           &error_fatal);
+    memory_region_add_subregion(get_system_memory(), APPLE_AIC_TEST_RAM_BASE,
+                                ram);
+
+    cpuobj = object_new(ms->cpu_type);
+    s->cpu = ARM_CPU(cpuobj);
+    cpudev = DEVICE(cpuobj);
+    s->cpu->has_el2 = false;
+    s->cpu->has_el3 = false;
+    unset_feature(&s->cpu->env, ARM_FEATURE_EL2);
+    unset_feature(&s->cpu->env, ARM_FEATURE_EL3);
+    s->cpu->gt_cntfrq_hz = 24000000;
+
+    s->aic = apple_aic_create_simple(variant->aic_version, variant->num_irqs,
+                                     variant->aic_physlen, variant->iack_offset,
+                                     variant->has_ack_region);
+    sysbus_mmio_map(SYS_BUS_DEVICE(s->aic), 0, variant->aic_base);
+
+    s->aic_in = g_new0(qemu_irq, s->num_irqs);
+    for (i = 0; i < s->num_irqs; i++) {
+        s->aic_in[i] = qdev_get_gpio_in(s->aic, i);
+    }
+
+    memory_region_init_io(&s->ctrl, OBJECT(ms), &apple_aic_test_ctrl_ops, s,
+                          "apple-aic-test-ctrl", APPLE_AIC_TEST_CTRL_SIZE);
+    memory_region_add_subregion(get_system_memory(), APPLE_AIC_TEST_CTRL_BASE,
+                                &s->ctrl);
+
+    pl011_create(variant->uart_base, s->aic_in[variant->uart_irq],
+                 serial_hd(0));
+
+    qdev_realize(cpudev, NULL, &error_fatal);
+
+    if (variant->timer_fiq) {
+        qdev_connect_gpio_out(cpudev, GTIMER_PHYS,
+                              qdev_get_gpio_in(cpudev, ARM_CPU_FIQ));
+    } else {
+        qdev_connect_gpio_out(cpudev, GTIMER_PHYS,
+                              s->aic_in[variant->timer_irq]);
+    }
+    qdev_connect_gpio_out(s->aic, 0, qdev_get_gpio_in(cpudev, ARM_CPU_IRQ));
+}
+
+static void apple_aic_v1_init(MachineState *ms)
+{
+    apple_aic_test_init(ms, &apple_aic_v1_variant);
+}
+
+static void apple_aic_v2_init(MachineState *ms)
+{
+    apple_aic_test_init(ms, &apple_aic_v2_variant);
+}
+
+static void apple_aic_test_machine_init(MachineClass *mc)
+{
+    mc->desc = "Apple AIC v1 test machine";
+    mc->init = apple_aic_v1_init;
+    mc->max_cpus = 1;
+    mc->default_cpu_type = ARM_CPU_TYPE_NAME("max");
+}
+
+static void apple_aic_v2_test_machine_init(MachineClass *mc)
+{
+    mc->desc = "Apple AIC v2 test machine (M1 Pro layout)";
+    mc->init = apple_aic_v2_init;
+    mc->max_cpus = 1;
+    mc->default_cpu_type = ARM_CPU_TYPE_NAME("max");
+}
+
+static void apple_aic_test_machine_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    apple_aic_test_machine_init(mc);
+}
+
+static void apple_aic_v2_test_machine_class_init(ObjectClass *oc,
+                                                 const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    apple_aic_v2_test_machine_init(mc);
+}
+
+static const TypeInfo apple_aic_test_machine_typeinfo = {
+    .name = TYPE_APPLE_AIC_TEST_MACHINE,
+    .parent = TYPE_MACHINE,
+    .class_init = apple_aic_test_machine_class_init,
+    .instance_size = sizeof(AppleAICTestState),
+    .interfaces = arm_machine_interfaces,
+};
+
+static const TypeInfo apple_aic_v2_test_machine_typeinfo = {
+    .name = TYPE_APPLE_AIC_V2_TEST_MACHINE,
+    .parent = TYPE_APPLE_AIC_TEST_MACHINE,
+    .class_init = apple_aic_v2_test_machine_class_init,
+    .instance_size = sizeof(AppleAICTestState),
+};
+
+static void apple_aic_test_register_types(void)
+{
+    type_register_static(&apple_aic_test_machine_typeinfo);
+    type_register_static(&apple_aic_v2_test_machine_typeinfo);
+}
+
+type_init(apple_aic_test_register_types)
